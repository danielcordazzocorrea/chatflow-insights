{
  "name": "Envio em massa automático",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "CONFIGURE_WEBHOOK_PATH",
        "authentication": "headerAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "name": "Webhook"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "campaign",
              "name": "campanha_id",
              "value": "={{ $json.body?.campanha_id ?? $json.campanha_id }}",
              "type": "number"
            },
            {
              "id": "stage",
              "name": "etapa",
              "value": "={{ $json.body?.etapa ?? $json.etapa ?? 0 }}",
              "type": "number"
            },
            {
              "id": "template",
              "name": "template_name",
              "value": "={{ $json.body?.template?.name ?? $json.template?.name ?? '' }}",
              "type": "string"
            },
            {
              "id": "language",
              "name": "template_language",
              "value": "={{ $json.body?.template?.language ?? $json.template?.language ?? 'pt_BR' }}",
              "type": "string"
            },
            {
              "id": "template_text",
              "name": "template_text",
              "value": "={{ ($json.body?.template?.components ?? $json.template?.components ?? []).find(component => String(component.type ?? '').toUpperCase() === 'BODY')?.text ?? ('Template: ' + ($json.body?.template?.name ?? $json.template?.name ?? '')) }}",
              "type": "string"
            },
            {
              "id": "event",
              "name": "event_id",
              "value": "={{ $json.body?.event_id ?? $json.event_id ?? '' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {
          "ignoreConversionErrors": false
        }
      },
      "name": "Normalizar disparo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        272,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "campanhas",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Normalizar disparo').item.json.campanha_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "em_andamento"
            }
          ]
        }
      },
      "name": "Marcar campanha em andamento",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        528,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "envio_em_massa",
        "returnAll": true,
        "orderBy": "id.asc",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "campanha_id",
              "condition": "eq",
              "keyValue": "={{ $('Normalizar disparo').item.json.campanha_id }}"
            },
            {
              "keyName": "etapa",
              "condition": "eq",
              "keyValue": "={{ $('Normalizar disparo').item.json.etapa }}"
            }
          ]
        }
      },
      "name": "Buscar contatos da campanha",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        784,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Processar um contato por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "envio_em_massa",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Buscar contatos da campanha').item.json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "etapa",
              "fieldValue": "={{ Number($('Normalizar disparo').item.json.etapa) + 1 }}"
            }
          ]
        }
      },
      "name": "Avançar etapa do contato",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1824,
        112
      ]
    },
    {
      "parameters": {
        "amount": 1
      },
      "name": "Intervalo entre envios",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2080,
        112
