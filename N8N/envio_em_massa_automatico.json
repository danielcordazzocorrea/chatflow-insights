    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "campanhas",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Normalizar disparo').item.json.campanha_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "concluida"
            }
          ]
        }
      },
      "name": "Marcar campanha concluída",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1312,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v23.0/CONFIGURE_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: String($json.telefone ?? $json.bsuid ?? '').replace(/\\D/g, ''), type: 'template', template: { name: $('Normalizar disparo').item.json.template_name, language: { code: $('Normalizar disparo').item.json.template_language }, components: [{ type: 'body', parameters: [{ type: 'text', text: String($json.nome ?? 'Cliente') }] }] } } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "name": "Enviar template Meta via HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1312,
        112
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "webhook_messages",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "message_id",
              "fieldValue": "={{ $json.messages?.[0]?.id }}"
            },
            {
              "fieldId": "message_status",
              "fieldValue": "={{ $json.messages?.[0]?.message_status ?? 'sent' }}"
            },
            {
              "fieldId": "message_text",
              "fieldValue": "={{ String($('Normalizar disparo').item.json.template_text).replace(/\\{\\{1\\}\\}/g, $('Buscar contatos da campanha').item.json.nome ?? 'Cliente') }}"
            },
            {
              "fieldId": "who_sent",
              "fieldValue": "campaign"
            },
            {
              "fieldId": "telefone",
              "fieldValue": "={{ $json.contacts?.[0]?.wa_id ?? (String($('Buscar contatos da campanha').item.json.telefone ?? '').replace(/\\D/g, '').startsWith('55') ? String($('Buscar contatos da campanha').item.json.telefone).replace(/\\D/g, '') : '55' + String($('Buscar contatos da campanha').item.json.telefone ?? '').replace(/\\D/g, '')) }}"
            },
            {
              "fieldId": "bsuid",
              "fieldValue": "={{ $json.contacts?.[0]?.user_id ?? $json.contacts?.[0]?.wa_id ?? $('Buscar contatos da campanha').item.json.bsuid ?? '' }}"
            },
            {
              "fieldId": "campanha_id",
              "fieldValue": "={{ $('Normalizar disparo').item.json.campanha_id }}"
            },
            {
              "fieldId": "envio_em_massa_id",
              "fieldValue": "={{ $('Buscar contatos da campanha').item.json.id }}"
            }
          ]
        }
      },
      "name": "Salvar em webhook_messages",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1568,
        112
